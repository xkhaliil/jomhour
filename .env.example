# Supabase project — public, safe for the browser (anon key is RLS-restricted)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — powers the admin "AI draft" chant assist
ANTHROPIC_API_KEY=

# Used to build the fan join link shown on the admin dashboard and public match page
NEXT_PUBLIC_SITE_URL=http://localhost:3000
