# Supabase Postgres — pooled connection (Supavisor/PgBouncer, port 6543), used by Prisma at runtime
DATABASE_URL=postgresql://postgres.aswcbficbioejzlattxo:rUJnnrA2DOSsdLdQ@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Supabase Postgres — direct connection (port 5432), used only for `prisma migrate`
